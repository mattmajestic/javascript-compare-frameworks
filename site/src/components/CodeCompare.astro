---
import { Code } from 'astro:components';
import { FRAMEWORKS, sourceUrl } from '@compare/core';
import { CONCEPTS, getSnippets } from '../lib/code';

const concepts = CONCEPTS.map((concept) => ({
  ...concept,
  frameworks: FRAMEWORKS.map((fw) => {
    const snippets = getSnippets(fw.id, concept.sources(fw.id));
    const lines = snippets.reduce((n, s) => n + s.code.split('\n').filter((l) => l.trim()).length, 0);
    return { fw, snippets, lines };
  }),
}));
---

<div class="code-compare">
  <div class="controls">
    <div class="segmented" role="tablist" aria-label="Concept">
      {
        concepts.map((c, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${c.id}`}
            aria-controls={`panel-${c.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {c.title}
          </button>
        ))
      }
    </div>
    <div class="segmented filters" role="group" aria-label="Frameworks to show">
      {
        FRAMEWORKS.map((fw) => (
          <button type="button" aria-pressed="true" data-filter={fw.id} style={`--fw: ${fw.color}`}>
            <span class="fw-dot" />
            {fw.name}
          </button>
        ))
      }
    </div>
  </div>

  {
    concepts.map((c, i) => (
      <div class="panel" role="tabpanel" id={`panel-${c.id}`} aria-labelledby={`tab-${c.id}`} hidden={i !== 0}>
        <p class="summary">{c.summary}</p>
        <div class="grid">
          {c.frameworks.map(({ fw, snippets, lines }) => (
            <article class="code-card card" data-fw={fw.id} style={`--fw: ${fw.color}`}>
              <header>
                <span class="fw-dot" />
                <strong>{fw.name}</strong>
                <span class="lines">{lines} lines</span>
                <a href={sourceUrl(fw.id)} target="_blank" rel="noreferrer" aria-label={`${fw.name} source on GitHub`}>
                  ↗
                </a>
              </header>
              {snippets.map((s) => (
                <div class="snippet">
                  <div class="file">{s.file}</div>
                  <Code code={s.code} lang={s.lang as any} themes={{ light: 'github-light', dark: 'github-dark' }} />
                </div>
              ))}
            </article>
          ))}
        </div>
      </div>
    ))
  }
</div>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.code-compare [role="tab"]')];

  function select(tab: HTMLButtonElement) {
    for (const t of tabs) {
      const selected = t === tab;
      t.setAttribute('aria-selected', String(selected));
      t.tabIndex = selected ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !selected;
    }
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const step = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
      if (!step) return;
      const next = tabs[(i + step + tabs.length) % tabs.length];
      select(next);
      next.focus();
    });
  });

  for (const button of document.querySelectorAll<HTMLButtonElement>('.code-compare [data-filter]')) {
    button.addEventListener('click', () => {
      const show = button.getAttribute('aria-pressed') !== 'true';
      button.setAttribute('aria-pressed', String(show));
      for (const card of document.querySelectorAll<HTMLElement>(`.code-card[data-fw="${button.dataset.filter}"]`)) {
        card.hidden = !show;
      }
    });
  }
</script>

<style>
  .controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
  }
  .filters button[aria-pressed='false'] .fw-dot {
    opacity: 0.3;
  }
  .summary {
    margin: 0 0 20px;
    color: var(--muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 520px), 1fr));
    gap: 16px;
  }
  .code-card {
    min-width: 0;
    overflow: hidden;
  }
  .code-card[hidden] {
    display: none;
  }
  .code-card header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    box-shadow: inset 3px 0 0 var(--fw);
  }
  .lines {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .code-card header a {
    color: var(--muted);
    text-decoration: none;
  }
  .file {
    padding: 8px 16px 0;
    color: var(--faint);
    font-family: var(--mono);
    font-size: 0.75rem;
  }
  .snippet + .snippet {
    border-top: 1px dashed var(--border);
  }
  .snippet :global(pre) {
    max-height: 460px;
    margin: 0;
    padding: 10px 16px 16px;
    overflow: auto;
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  .snippet :global(code) {
    padding: 0;
    background: none;
  }
</style>
