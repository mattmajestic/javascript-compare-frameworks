---
import '../styles/site.css';
import { REPO_URL } from '@compare/core';

const title = 'One App, Six Frameworks';
const description =
  'The same holiday countdown built in React, Vue, Svelte, Solid, Angular and Astro, measured and compared side by side.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⏳</text></svg>" />
    <title>{title}</title>
  </head>
  <body>
    <header class="nav">
      <div class="container nav-inner">
        <a class="logo" href="#top">⏳ <span>One App, Six Frameworks</span></a>
        <nav aria-label="Sections">
          <a href="#demos">Demos</a>
          <a href="#metrics">Metrics</a>
          <a href="#code">Code</a>
          <a href="#verdicts">Verdicts</a>
          <a href={REPO_URL} target="_blank" rel="noreferrer">GitHub ↗</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="footer">
      <div class="container footer-inner">
        <p>
          Built by <a href="https://www.youtube.com/@majesticcoding" target="_blank" rel="noreferrer">Majestic Coding</a>.
          Metrics are regenerated by <code>npm run build</code>.
        </p>
        <a href={REPO_URL} target="_blank" rel="noreferrer">Source on GitHub ↗</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border);
    background: color-mix(in oklab, var(--bg) 80%, transparent);
    backdrop-filter: blur(14px);
  }
  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    height: 60px;
  }
  .logo {
    font-weight: 800;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }
  nav {
    display: flex;
    gap: clamp(12px, 2.5vw, 28px);
    overflow-x: auto;
    font-size: 0.9rem;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--text);
  }
  @media (max-width: 640px) {
    .logo span {
      display: none;
    }
  }
  .footer {
    padding-block: 40px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
  }
  .footer p {
    margin: 0;
  }
</style>
