---
import '../styles/site.css';
import AirtableMark from '../components/AirtableMark.astro';
import GitHubMark from '../components/GitHubMark.astro';
import { REPO_URL } from '@compare/core';
import ThemeMenu from '../components/ThemeMenu.astro';

const title = 'One App, Six Frameworks';
const description =
  'The same holiday countdown built in React, Vue, Svelte, Solid, Angular and Astro, measured and compared side by side.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⏳</text></svg>" />
    <title>{title}</title>
    <script is:inline>
      // Apply a saved theme before first paint so there's no flash of the wrong one.
      try {
        const saved = localStorage.getItem('color-scheme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.colorScheme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <header class="nav">
      <div class="container nav-inner">
        <a class="logo" href="#top">⏳ <span>One App, Six Frameworks</span></a>
        <nav aria-label="Sections">
          <a href="#demos">Demos</a>
          <a href="#metrics">Metrics</a>
          <a href="#performance">Performance</a>
          <a href="#live">Live</a>
          <a href="#code">Code</a>
          <a href="#verdicts">Verdicts</a>
        </nav>
        <a class="synced" href="#live" aria-label="Synced with Airtable" title="Countdowns and benchmark runs are stored in Airtable">
          <AirtableMark />
          <span>Synced with Airtable</span>
        </a>
        <a class="icon-link" href={REPO_URL} target="_blank" rel="noreferrer" aria-label="Source on GitHub" title="Source on GitHub">
          <GitHubMark />
        </a>
        <ThemeMenu />
      </div>
    </header>
    <slot />
    <footer class="footer">
      <div class="container footer-inner">
        <p>
          Built by <a href="https://www.youtube.com/@majesticcoding" target="_blank" rel="noreferrer">Majestic Coding</a>.
          Metrics are regenerated by <code>npm run build</code>. Live data lives in{' '}
          <a class="airtable-credit" href="https://airtable.com" target="_blank" rel="noreferrer"><AirtableMark size={13} />{' '}Airtable</a>.
        </p>
        <a class="footer-github" href={REPO_URL} target="_blank" rel="noreferrer" aria-label="Source on GitHub" title="Source on GitHub"><GitHubMark size={18} /></a>
      </div>
    </footer>
  </body>
</html>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border);
    background: color-mix(in oklab, var(--bg) 80%, transparent);
    backdrop-filter: blur(14px);
  }
  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    height: 60px;
  }
  .logo {
    font-weight: 800;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }
  nav {
    display: flex;
    gap: clamp(12px, 2.5vw, 28px);
    overflow-x: auto;
    font-size: 0.9rem;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--text);
  }
  nav {
    margin-left: auto;
  }
  .synced {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .synced:hover {
    border-color: color-mix(in oklab, #18bfff 45%, var(--border));
    color: var(--text);
  }
  .icon-link {
    display: grid;
    flex: none;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    color: var(--muted);
  }
  .icon-link:hover {
    background: var(--surface-2);
    color: var(--text);
  }
  .footer-github {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  @media (max-width: 1100px) {
    .synced span {
      display: none;
    }
    .synced {
      padding: 7px;
    }
  }
  @media (max-width: 640px) {
    .logo span {
      display: none;
    }
  }
  .footer {
    padding-block: 40px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
  }
  .footer p {
    margin: 0;
  }
</style>
