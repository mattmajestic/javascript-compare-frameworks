---
import { formatDate, timeLeft } from '@compare/core';
import type { CountdownEvent } from '@compare/core';

type Props = { event: CountdownEvent; now: Date };

const { event, now } = Astro.props;
const { done, units } = timeLeft(event.date, now);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-emoji" aria-hidden="true">{event.emoji}</div>
  <h1 class="hero-title" id="hero-title">{event.name}</h1>
  <p class="hero-date">{formatDate(event.date)}</p>
  <p class="hero-done" hidden={!done}>🎉 It's here!</p>
  <div class="units" role="timer" hidden={done}>
    {
      units.map((unit) => (
        <div class="unit" data-unit={unit.key}>
          <span class="unit-value">{unit.value}</span>
          <span class="unit-label">{unit.label}</span>
        </div>
      ))
    }
  </div>
</section>
